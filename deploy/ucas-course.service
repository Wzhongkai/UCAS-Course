[Unit]
Description=UCAS Course web app and automatic sign-in worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@RUN_USER@@
Group=@@RUN_USER@@
WorkingDirectory=@@PROJECT_DIR@@
Environment=NODE_ENV=production
Environment=APP_BASE_PATH=@@APP_BASE_PATH@@
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=@@APP_PORT@@
Environment=AUTO_SIGN_DATA_DIR=@@DATA_DIR@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=@@NODE_BIN@@ scripts/run.mjs start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
